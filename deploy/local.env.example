# Copy to deploy/local.env (gitignored) and fill in. Nothing in this file belongs in the repository.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN_FILE=$HOME/.config/rh-airdrop/cf-token

WORKER_AIRDROP=rh-airdrop
WORKER_CHECK=rh-check

# Only needed if the workers have custom domains you want verified after publishing.
URL_AIRDROP=https://example.com/
URL_CHECK=https://example.com/

# Where the worker fetches the WalletConnect bundle it serves at /wc.js, so the page imports it same-origin.
WC_BUNDLE_URL=https://example.com/wc.js

# Optional second copy on an ordinary web host. Called as: $ORIGIN_PUBLISH_CMD <built file> <name>
# ORIGIN_PUBLISH_CMD=/path/to/your/upload-script

# The connector, published as its own step and before the worker that pins its digest is activated. Without
# it the bundle has to reach WC_BUNDLE_URL some other way; either way publish.sh fetches that exact URL and
# refuses to activate a worker built against a digest the origin does not serve.
# ORIGIN_PUBLISH_WC_CMD=/path/to/your/upload-script

# Only for a first-ever deploy, where no origin copy can exist yet.
# ALLOW_CONNECTOR_GAP=1

# Gate 11, optional: a file holding a Blockscout PRO API key (free tier: 5 requests a second). When set, the
# Worker reads the MAINNET explorer through api.blockscout.com with the key bound as a Worker secret, because
# the mainnet explorer challenges every non-browser client. Leave unset and the Worker behaves as before.
#BLOCKSCOUT_KEY_FILE=/home/you/.config/rh-airdrop/blockscout-key
